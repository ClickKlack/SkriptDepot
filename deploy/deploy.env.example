# Kopie als deploy/deploy.env anlegen und ausfüllen. deploy/deploy.env liegt nicht im Git.

# SSH-Alias oder user@host des Webspace
DEPLOY_SSH_HOST=mein-webspace

# Anwendungsverzeichnis auf dem Server, relativ zum Home des SSH-Nutzers.
# Der Dokumentroot der Domain muss auf dessen Unterordner "public" zeigen.
DEPLOY_REMOTE_PATH=example.de

# PHP-Binary auf dem Server für Artisan (mindestens 8.4), bei Plesk zum Beispiel /opt/plesk/php/8.4/bin/php
DEPLOY_PHP=php
